---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Ascii3D from '../components/Ascii3D.astro';
import Box from '../components/Box.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE } from '../site';

const posts = await getPublishedPosts();
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

// figlet Standard, dos bloques: "santiago" y, debajo, "ascii" alineado a su
// borde derecho (el padding se calcula, no se ajusta a ojo).
const santiagoLines = [
  '                  _   _',
  '  ___  __ _ _ __ | |_(_) __ _  __ _  ___',
  " / __|/ _` | '_ \\| __| |/ _` |/ _` |/ _ \\",
  ' \\__ \\ (_| | | | | |_| | (_| | (_| | (_) |',
  ' |___/\\__,_|_| |_|\\__|_|\\__,_|\\__, |\\___/',
  '                              |___/',
];
const asciiLines = [
  '                 _ _',
  '   __ _ ___  ___(_|_)',
  '  / _` / __|/ __| | |',
  ' | (_| \\__ \\ (__| | |',
  '  \\__,_|___/\\___|_|_|',
];
// Dos bloques independientes: en ancho "ascii" se alinea al borde derecho
// de "santiago"; en móvil se apilan a la izquierda (CSS: .masthead).
const blocks = [
  { lines: santiagoLines, accent: false },
  { lines: asciiLines, accent: true },
];
---

<Base>
  <h1 class="sr-only">{SITE.title}</h1>

  <section class="hero">
    <div>
      <div class="masthead" role="img" aria-label={SITE.title}>
        {
          blocks.map(({ lines, accent }) => (
            <pre class:list={[accent && 'masthead-accent']}>{lines.join('\n')}</pre>
          ))
        }
      </div>
      <p class="masthead-tagline">
        <span aria-hidden="true">&gt; </span>{SITE.description.toLowerCase().replace(/\.$/, '')}<span
          class="cursor"
          aria-hidden="true"></span>
      </p>
    </div>
    <Ascii3D shape="gem" cols={46} rows={23} yaw={0.4} class="hero-shape" />
  </section>

  <div class="section-head">
    <h2>memory card 1</h2>
    <i aria-hidden="true"></i>
    <span>{posts.length} {posts.length === 1 ? 'bloque' : 'bloques'}</span>
  </div>

  <!-- Buscador cliente: filtra el listado por título/descripción/tags.
       Arranca oculto y lo revela el script, así sin JS no hay UI muerta
       (las páginas /tags/ siguen siendo la vía navegable). -->
  <section data-filter hidden class="mt-5" aria-label="Buscar y filtrar posts">
    <Box class="search-box">
      <label class="search">
        <span aria-hidden="true">&gt;</span>
        <input
          type="search"
          placeholder="buscar…"
          aria-label="Buscar por título, descripción o tag"
        />
        <span id="filter-count" class="search-count" aria-live="polite"
          >{posts.length}/{posts.length}</span
        >
      </label>
    </Box>
    {
      allTags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
          {allTags.map((tag) => (
            <button type="button" class="chip" data-chip={tag} aria-pressed="false">
              #{tag}
            </button>
          ))}
        </div>
      )
    }
  </section>

  <div class="mt-6">
    <PostList posts={posts} />
  </div>
  <p id="filter-empty" hidden class="mt-8 text-sm text-muted">
    no hay datos —
    <button type="button" id="filter-reset" class="cursor-pointer underline hover:text-accent">
      limpiar
    </button>
  </p>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  const list = document.getElementById('post-list');
  if (root && list) {
    root.hidden = false;
    const input = root.querySelector('input')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const count = document.getElementById('filter-count')!;
    const empty = document.getElementById('filter-empty');
    const items = [...list.querySelectorAll<HTMLElement>('[data-post]')];
    const active = new Set<string>();

    // Sin acentos ni mayúsculas: "bitacora" encuentra "Bitácora".
    const norm = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

    const apply = () => {
      const query = norm(input.value.trim());
      let shown = 0;
      for (const item of items) {
        const text = norm(item.dataset.post ?? '');
        const tags = (item.dataset.tags ?? '').split(' ');
        const visible =
          (!query || text.includes(query)) && [...active].every((tag) => tags.includes(tag));
        item.hidden = !visible;
        if (visible) shown += 1;
      }
      count.textContent = `${shown}/${items.length}`;
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const tag = chip.dataset.chip ?? '';
        if (active.has(tag)) {
          active.delete(tag);
        } else {
          active.add(tag);
        }
        chip.setAttribute('aria-pressed', String(active.has(tag)));
        apply();
      });
    }
    document.getElementById('filter-reset')?.addEventListener('click', () => {
      input.value = '';
      active.clear();
      for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
      apply();
    });
  }
</script>
