---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate, postStats, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const stats = postStats(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/${post.id}.png`}
  ogType="article"
>
  <article>
    <header class="mb-12">
      <p class="crumb"><a href="/" data-nav>archivo</a> / {post.id}</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      <!-- Ficha del archivo, como la pantalla de datos de una partida guardada. -->
      <dl class="fileinfo">
        <div>
          <dt>Fecha</dt>
          <dd><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></dd>
        </div>
        {
          post.data.updated && (
            <div>
              <dt>Actualizado</dt>
              <dd>
                <time datetime={post.data.updated.toISOString()}>
                  {formatDate(post.data.updated)}
                </time>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Tamaño</dt>
          <dd>{stats.size}</dd>
        </div>
        <div>
          <dt>Lectura</dt>
          <dd>{stats.minutes} min</dd>
        </div>
        {
          post.data.tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd class="flex flex-wrap gap-x-3">
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="eof" aria-hidden="true"><span>fin de los datos</span></p>
  </article>
</Base>
