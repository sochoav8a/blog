---
import Base from '../layouts/Base.astro';
import Box from '../components/Box.astro';
---

<Base title="404">
  <Box class="corrupt" title="error" status="404">
    <pre class="corrupt-icon" aria-hidden="true">{`  ?%#@?.
 #?  .%?:
 %@?##?.@
 :?.  ?#%
  ?@%#?:`}</pre>
    <div>
      <h1 class="post-title">datos corruptos</h1>
      <p class="mt-3 text-muted">
        Este bloque no existe o se dañó en el camino. <a href="/" data-nav>Volver al archivo</a>.
      </p>
    </div>
  </Box>
</Base>
