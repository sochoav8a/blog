---
// Lámina ASCII: una pieza generada con `pnpm ascii` (ver src/ascii/rails.ts)
// dentro de un marco de caracteres, con su pie en el borde. Decorativa.
import Box from './Box.astro';
import type { RailArt } from '../ascii/rails';

interface Props {
  figure: RailArt;
}

const { figure } = Astro.props;
---

<Box class="ascii-fig" status={figure.label}>
  <pre
    class:list={['ascii-art', figure.fine && 'ascii-art-fine']}
    aria-hidden="true"
    set:html={figure.art}
  />
</Box>
