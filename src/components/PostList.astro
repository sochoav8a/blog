---
// Listado de posts como memory card: una cuadrícula de bloques, cada uno
// con su icono 3D en ASCII (la forma sale del slug, así que es estable).
// Los huecos que sobran se dibujan como bloques vacíos.
import Box from './Box.astro';
import Ascii3D from './Ascii3D.astro';
import { shapeFor } from '../lib/ascii3d';
import { formatDate, postStats, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const COLUMNS = 3;
const slots = Math.max(COLUMNS * 2, Math.ceil(posts.length / COLUMNS) * COLUMNS);
const empty = Array.from({ length: slots - posts.length }, (_, i) => posts.length + i + 1);
const block = (n: number) => String(n).padStart(2, '0');
---

<ul id="post-list" class="card">
  {
    posts.map((post, i) => {
      const stats = postStats(post);
      return (
        <li
          data-post={[
            post.data.title,
            post.data.description,
            ...post.data.tags.map((tag) => `#${tag}`),
          ].join(' ')}
          data-tags={post.data.tags.join(' ')}
        >
          <Box class="slot" title={block(i + 1)} status={stats.size} hot>
            <article>
              <Ascii3D shape={shapeFor(post.id)} yaw={0.6 + i * 0.9} class="slot-icon" />
              <h2 class="slot-title">
                <a href={`/posts/${post.id}/`} data-nav>
                  {post.data.title}
                </a>
              </h2>
              <p class="slot-desc">{post.data.description}</p>
              <p class="slot-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {post.data.draft && <span class="text-warm">draft</span>}
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </p>
            </article>
          </Box>
        </li>
      );
    })
  }
  {
    empty.map((n) => (
      <li class="slot-empty" aria-hidden="true">
        <Box class="slot" title={block(n)}>
          <p>bloque libre</p>
        </Box>
      </li>
    ))
  }
</ul>
